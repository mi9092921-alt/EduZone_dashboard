# Environment Variables — EduZone Admin Dashboard
# Copy this file to .env.local and fill in the values

# Supabase Cloud 1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only key. Never expose this to the browser or commit a populated value.
# SECURITY FIX (2026-09-12): required when NEXT_PUBLIC_APP_ENV=production;
# getServerEnv() in src/lib/env.ts fails the boot-time validation in
# instrumentation.ts register() if this is missing in prod.
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-local-development-only-key


# YOUTUBE API KEY
YOUTUBE_API_KEY= 

# App Environment
# Must be one of: development | staging | production
# When set to "production", SUPABASE_SERVICE_ROLE_KEY and CRON_SECRET become
# required (validated at boot by instrumentation.ts).
NEXT_PUBLIC_APP_ENV=development
NODE_ENV=development

# Sentry (Optional for local dev)
# Client-side Sentry DSN — bundled into the browser.
NEXT_PUBLIC_SENTRY_DSN=

# Server-side Sentry DSN (separate from NEXT_PUBLIC_SENTRY_DSN — read by
# sentry.server.config.ts and sentry.edge.config.ts). Optional but
# strongly recommended in production.
SENTRY_DSN=

# Cron secret — required in production for /api/cron/routine
# The cron endpoint compares Authorization: Bearer <CRON_SECRET> using
# timingSafeEqual. Without this, Vercel cron hits the endpoint every 5
# minutes and gets a 401 forever (visible only in logs).
CRON_SECRET=
