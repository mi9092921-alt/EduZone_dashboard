# Environment Variables — EduZone Admin Dashboard
# Copy this file to .env.local and fill in the values

# Supabase Cloud 1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only key. Never expose this to the browser or commit a populated value.
# SECURITY FIX (2026-09-12): required when NEXT_PUBLIC_APP_ENV=production;
# getServerEnv() in src/lib/env.ts fails the boot-time validation in
# instrumentation.ts register() if this is missing in prod.
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-local-development-only-key


# YOUTUBE API KEY
YOUTUBE_API_KEY= 

# App Environment
# Must be one of: development | staging | production
# When set to "production", SUPABASE_SERVICE_ROLE_KEY and CRON_SECRET become
# required (validated at boot by instrumentation.ts).
NEXT_PUBLIC_APP_ENV=development
NODE_ENV=development

# Sentry (Optional for local dev)
# Client-side Sentry DSN — bundled into the browser.
NEXT_PUBLIC_SENTRY_DSN=

# Server-side Sentry DSN (separate from NEXT_PUBLIC_SENTRY_DSN — read by
# sentry.server.config.ts and sentry.edge.config.ts). Optional but
# strongly recommended in production.
SENTRY_DSN=

# Cron secret — required in production for /api/cron/routine
# The cron endpoint compares Authorization: Bearer <CRON_SECRET> using
# timingSafeEqual. Without this, Vercel cron hits the endpoint every 5
# minutes and gets a 401 forever (visible only in logs).
CRON_SECRET=

# ── SECURITY FIX (2026-09-12) ───────────────────────────────────────────
# Supabase Auth + Edge Functions CORS allow-lists.
# These MUST be set in every environment (dev / staging / prod) — they are
# the only thing preventing wildcard-CORS on the authenticated edge
# endpoints (create-user, bulk-action, bulk-worker, bulk-export,
# export-report, get-lesson-content, validate-course-access, video-info,
# log-download-attempt).
#
# SUPABASE_AUTH_SITE_URL — the public origin of the dashboard itself
#   (e.g. https://admin.eduzone.example). Used as the Auth service
#   `site_url` (email links, post-auth redirects).
#
# SUPABASE_AUTH_ADDITIONAL_REDIRECT_URLS — comma-separated list of
#   additional origins Auth is allowed to redirect to. In dev this is
#   typically http://localhost:3000,http://127.0.0.1:3000. In prod this
#   should be empty or only the canonical admin origin.
#
# ALLOWED_ORIGINS — comma-separated list of browser origins permitted to
#   invoke the authenticated edge functions via CORS. The Supabase project
#   URL itself is always auto-allowed; this list adds the dashboard
#   origins (e.g. https://admin.eduzone.example,http://localhost:3000).
SUPABASE_AUTH_SITE_URL=http://localhost:3000
SUPABASE_AUTH_ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
