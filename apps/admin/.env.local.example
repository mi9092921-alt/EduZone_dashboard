# Environment Variables — EduZone Admin Dashboard
# Copy this file to .env.local and fill in the values

# Supabase Cloud 1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only key. Never expose this to the browser or commit a populated value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-local-development-only-key

# Required by protected cron routes in every environment.
CRON_SECRET=replace-with-a-long-random-local-secret

# App Environment
NEXT_PUBLIC_APP_ENV=development
NODE_ENV=development

# Sentry (Optional for local dev)
NEXT_PUBLIC_SENTRY_DSN=
