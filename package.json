{
  "name": "eduzone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "pnpm --filter @eduzone/admin start",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage",
    "test:e2e": "pnpm --filter @eduzone/admin test:e2e",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.5.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.15": "1.1.18",
      "brace-expansion@5.0.6": "5.0.9",
      "form-data@4.0.5": "4.0.6",
      "js-yaml@4.2.0": "4.3.1",
      "nanoid@3.3.12": "3.3.18",
      "postcss@8.4.31": "8.5.18",
      "postcss@8.5.15": "8.5.18",
      "undici@7.27.1": "7.29.0"
    }
  }
}
